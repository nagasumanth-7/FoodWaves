# Django Security & Core Settings
DJANGO_SECRET_KEY=replace-with-a-cryptographically-strong-secret-key
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
SECURE_SSL_REDIRECT=True

# Supabase PostgreSQL Database (Transaction Pooler)
DB_NAME=postgres
DB_USER=your_supabase_pooler_user
DB_PASSWORD=your_supabase_pooler_password
DB_HOST=your-project-pooler.supabase.com
DB_PORT=5432

# Supabase Authentication & API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
